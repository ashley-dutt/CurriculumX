# Copy to .env (never commit .env)
GEMINI_API_KEY=paste-key-from-aistudio.google.com
# Check the exact model id in Google AI Studio. "gemini-flash-latest" is an alias that follows the current Flash model.
GEMINI_MODEL=gemini-flash-latest
ALLOWED_DOMAIN=lpu.in
# Set to 1 when the site is served over HTTPS (strongly recommended for a university-wide deployment)
COOKIE_SECURE=0
# Keep below your free-tier requests-per-minute shown in AI Studio
GEMINI_RPM=8
USER_AI_PER_HOUR=20
